import os

users = {
    "admin": {"password": "adminbarca", "role": "admin"},
    "user": {"password": "userbarca", "role": "user"},
}

pemain = {
    "1": {"nama": "Lionel Messi", "posisi": "Penyerang", "no": 10},
    "2": {"nama": "Luis Suarez", "posisi": "Penyerang", "no": 9},
    "3": {"nama": "Neymar Jr", "posisi": "Penyerang", "no": 11},
}
id_terakhir = 3

while True:
    os.system("cls")
    print("-------------------------------------")
    print("    DATA PEMAIN FC BARCELONA 2015    ")
    print("-------------------------------------")
    print("1. Login") 
    print("2. Register")
    print("3. Keluar")
    pilih = input("Pilih menu: ")

    if pilih == "1":
        username = input("Username: ")
        password = input("Password: ")
        role = ""
        if username in users and users[username]["password"] == password:
            role = users[username]["role"]

        if role == "":
            print("Username atau password salah, silahkan coba lagi")
            input("Kembali ke menu, tekan enter")
        else:
            while True:
                os.system("cls")
                print("=== MENU " + role.upper() + " ===")
                print("1. Lihat pemain")
                if role == "admin":
                    print("2. Tambah pemain")
                    print("3. Ubah pemain")
                    print("4. Hapus pemain")
                print("0. Logout")
                menu = input("Pilih menu: ")

                if menu == "1":
                    print("ID | Nama | Posisi | No Punggung")
                    for p in pemain:
                        print(f"{p} {pemain[p]['nama']}\t{pemain[p]['posisi']}\t{pemain[p]['no']}")
                    input("Kembali ke menu, tekan enter")

                elif menu == "2" and role == "admin":
                    nama = input("Nama: ")
                    posisi = input("Posisi: ")
                    no = input("No punggung: ")
                    if nama == "" or posisi == "":
                        print("Data tidak boleh kosong!")
                    elif not no.isdigit():
                        print("No punggung harus angka!")
                    else:
                        id_terakhir = id_terakhir + 1
                        pemain[str(id_terakhir)] = {"nama": nama, "posisi": posisi, "no": int(no)}
                        print("Pemain berhasil ditambahkan")
                    input("Kembali ke menu, tekan enter")

                elif menu == "3" and role == "admin":
                    id_user = input("Masukkan ID pemain: ")
                    if id_user not in pemain:
                        print("ID tidak ditemukan!")
                    else:
                        print("Kosongkan data yang tidak ingin diubah")
                        nama = input("Nama baru: ")
                        posisi = input("Posisi baru: ")
                        no = input("No punggung baru: ")
                        if no != "" and not no.isdigit():
                            print("No punggung harus angka!")
                        else:
                            if nama != "":
                                pemain[id_user]["nama"] = nama
                            if posisi != "":
                                pemain[id_user]["posisi"] = posisi
                            if no != "":
                                pemain[id_user]["no"] = int(no)
                            print("Data berhasil diubah")
                    input("Kembali ke menu, tekan enter")

                elif menu == "4" and role == "admin":
                    hapus_id = input("Masukkan ID pemain: ")
                    if hapus_id not in pemain:
                        print("ID tidak ditemukan!")
                    else:
                        del pemain[hapus_id]
                        print("Pemain berhasil dihapus")
                    input("Kembali ke menu, tekan enter")

                elif menu == "0":
                    break

                else:
                    print("Pilihan tidak valid!")
                    input("Kembali ke menu, tekan enter")

    elif pilih == "2":
        user_baru = input("Username baru: ")
        pass_baru = input("Password baru: ")
        if user_baru == "" or pass_baru == "":
            print("Username dan password tidak boleh kosong!")
        elif user_baru in users:
            print("Username sudah dipakai!")
        elif len(pass_baru) < 3:
            print("Password minimal 3 karakter!")
        else:
            users[user_baru] = {"password": pass_baru, "role": "user"}
            print("Register berhasil, silakan login")
        input("Kembali ke menu, tekan enter")

    elif pilih == "3":
        print("Terima kasih!")
        break

    else:
        print("Pilihan tidak valid!")
        input("Kembali ke menu, tekan enter")